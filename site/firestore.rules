rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.uid in [
               "7RAreEnN7HbpPlZpN5S8vag6vHo1",  // vajralotusfoundation@gmail.com
               "GN6NeDLPVGZzwyROnhgjVeOf97G3"   // mee (handover admin)
             ];
    }

    // Nội dung công khai: ai cũng ĐỌC, chỉ admin GHI.
    match /{coll}/{docId} {
      allow read: if coll in ["news", "gallery", "magazine", "publications", "prayerbooks"];
      allow create, update, delete: if isAdmin();
    }

    // Tin nhắn liên hệ: ai cũng GỬI được (có kiểm tra chống spam), chỉ admin ĐỌC/xoá.
    match /messages/{docId} {
      allow create: if request.resource.data.size() <= 10
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // Đăng ký nhận bản tin: ai cũng GỬI được (có kiểm tra), chỉ admin ĐỌC/xoá.
    match /subscribers/{docId} {
      allow create: if request.resource.data.size() <= 6
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320;
      allow read, update, delete: if isAdmin();
    }
  }
}
