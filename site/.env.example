# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# Fastest path: ask the person handing off for the real `.env` (send it over a
# secure channel). All VITE_* vars are bundled into the client (Vite) — this is
# public client config, NOT a secret. Real security lives in the Firestore rules
# + Firebase Auth, not in hiding these keys.

# --- Firebase (get from: Firebase Console > Project settings > Your apps > Web app) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (get from: Cloudinary Console; the preset must be "unsigned") ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Web3Forms (contact form email). Get a key at https://web3forms.com ---
VITE_WEB3FORMS_KEY=
